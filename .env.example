# Copy to .env and fill in. Never commit a real key.
# The Flutter client must not receive provider keys.

LLM_PROVIDER=auto
ENVIRONMENT=development

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_FAST_MODEL=gemini-2.0-flash
GEMINI_REASONING_MODEL=gemini-2.0-flash
GEMINI_RESEARCH_MODEL=gemini-2.0-flash

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

AUTH_SECRET=change-me-in-production
AUTH_TOKEN_TTL_HOURS=72

DATABASE_URL=postgresql+psycopg://vibeprompt:vibeprompt@localhost:5432/vibeprompt

# Set true only after the single-model idea generator is working.
ENABLE_MULTI_PERSPECTIVE=false

AUTO_CREATE_TABLES=true
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
CORS_ORIGINS=*
