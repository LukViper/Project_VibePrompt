+The module is deliberately framework-independent: these functions can be
+mounted in any Python web framework without coupling the domain logic to it.
+"""
+
+from __future__ import annotations
+
+from collections.abc import Mapping
+from typing import Any
+
+from app.redis_cache import RedisCache
+
+
+_cache: RedisCache | None = None
+
+
+def _get_cache() -> RedisCache:
+    """Create the process-wide Redis cache only when it is first needed."""
+    global _cache
+    if _cache is None:
+        _cache = RedisCache.from_environment()
+    return _cache
+
+
+def echo(payload: Mapping[str, Any], *, cache: RedisCache | None = None) -> dict[str, Any]:
+    """Return a JSON-compatible payload, using Redis to cache repeated calls.
+
+    A mapping is required to make the API contract explicit.  Redis failures
+    do not change the response: caching is an optimisation, while callers
+    still receive a valid echo response during a Redis outage.
+    """
+    if not isinstance(payload, Mapping):
+        raise ValueError("payload must be a mapping")
+
+    result = dict(payload)
+    selected_cache = cache or _get_cache()
+    return selected_cache.get_or_set(result)
+
+
+def health() -> dict[str, str]:
+    """REQ-001 liveness operation."""
+    return {"status": "ok"}
