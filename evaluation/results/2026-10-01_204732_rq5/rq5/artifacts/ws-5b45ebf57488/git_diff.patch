-NOTES = {}
+"""In-memory note service.
 
-def create_note(text):
-    raise NotImplementedError
+The module deliberately exposes no delete operation: deletion is outside the
+validated project scope.
+"""
 
-def list_notes():
-    raise NotImplementedError
+from __future__ import annotations
+
+from itertools import count
+from threading import Lock
+
+
+NOTES: dict[int, dict[str, object]] = {}
+_NEXT_ID = count(1)
+_LOCK = Lock()
+
+
+def create_note(text: str) -> int:
+    """Create a note and return its identifier.
+
+    Note text must be a non-empty string after trimming whitespace.  The stored
+    value is trimmed so callers get predictable data when listing notes.
+    """
+    if not isinstance(text, str):
+        raise ValueError("text must be a string")
+
+    normalized_text = text.strip()
+    if not normalized_text:
+        raise ValueError("text must not be empty")
+    if len(normalized_text) > 10_000:
+        raise ValueError("text must be 10,000 characters or fewer")
+
+    with _LOCK:
+        note_id = next(_NEXT_ID)
+        NOTES[note_id] = {"id": note_id, "text": normalized_text}
+    return note_id
+
+
+def list_notes() -> list[dict[str, object]]:
+    """Return copies of all notes in creation order."""
+    with _LOCK:
+        return [note.copy() for note in NOTES.values()]
