+"""Regression tests for the confirmed scaffold behavior."""
+
+import unittest
+
+from app import notes
+
+
+class NotesServiceTests(unittest.TestCase):
+    def setUp(self) -> None:
+        notes.NOTES.clear()
+
+    def test_create_and_list_note(self) -> None:
+        note_id = notes.create_note("hello")
+
+        self.assertEqual(notes.list_notes(), [{"id": note_id, "text": "hello"}])
+
+    def test_create_note_rejects_invalid_text(self) -> None:
+        for value in ("", "   ", None, 5):
+            with self.subTest(value=value):
+                with self.assertRaises(ValueError):
+                    notes.create_note(value)  # type: ignore[arg-type]
+
+    def test_list_returns_copies(self) -> None:
+        notes.create_note("private")
+        listed = notes.list_notes()
+        listed[0]["text"] = "changed"
+
+        self.assertEqual(notes.list_notes()[0]["text"], "private")