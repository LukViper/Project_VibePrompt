-    raise NotImplementedError
+"""Word-frequency utilities.
+
+This module deliberately has no external corpus or service dependency: it
+counts the whitespace-delimited tokens supplied by the caller.
+"""
+
+from collections import Counter
+
+
+def count_words(text: str) -> dict[str, int]:
+    """Return frequencies for whitespace-delimited words in *text*.
+
+    Token spelling and case are preserved so callers can choose any desired
+    normalisation before invoking this small, deterministic utility.
+
+    Raises:
+        TypeError: If ``text`` is not a string.
+    """
+    if not isinstance(text, str):
+        raise TypeError("text must be a string")
+
+    return dict(Counter(text.split()))
