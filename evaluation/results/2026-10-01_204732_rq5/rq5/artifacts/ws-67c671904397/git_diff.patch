 from app.words import count_words
 
+import pytest
+
+
 def test_count_words():
     assert count_words('a a b') == {'a': 2, 'b': 1}
+
+
+def test_count_words_uses_whitespace_delimited_tokens():
+    assert count_words('  hello\nhello\tworld  ') == {
+        'hello': 2,
+        'world': 1,
+    }
+
+
+def test_count_words_rejects_non_string_input():
+    with pytest.raises(TypeError, match='text must be a string'):
+        count_words(None)  # type: ignore[arg-type]