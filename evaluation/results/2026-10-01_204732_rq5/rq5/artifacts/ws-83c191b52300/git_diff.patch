+"""A small, in-memory URL shortener.
+
+``STORE`` is deliberately public so an application can replace it with its own
+mapping or clear it between runs/tests.  No network service is involved.
+"""
+
+from threading import RLock
+
+
 STORE = {}
+_ALPHABET = "0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ"
+_lock = RLock()
+
+
+def _encode(number):
+    """Encode a positive integer as a compact base-62 string."""
+    encoded = ""
+    while number:
+        number, remainder = divmod(number, len(_ALPHABET))
+        encoded = _ALPHABET[remainder] + encoded
+    return encoded or _ALPHABET[0]
+
 
 def shorten(url):
-    raise NotImplementedError
+    """Store *url* locally and return its short code.
+
+    Re-shortening the same URL returns its existing code.  Codes are generated
+    from local state and are unique for as long as ``STORE`` is retained.
+    """
+    if not isinstance(url, str) or not url:
+        raise ValueError("url must be a non-empty string")
+
+    with _lock:
+        for code, stored_url in STORE.items():
+            if stored_url == url:
+                return code
+
+        # Starting at len(STORE) makes a manually cleared STORE start fresh;
+        # the membership check also handles a STORE supplied by a caller.
+        sequence = len(STORE) + 1
+        code = _encode(sequence)
+        while code in STORE:
+            sequence += 1
+            code = _encode(sequence)
+        STORE[code] = url
+        return code
+
 
 def resolve(code):
-    raise NotImplementedError
+    """Return the URL for *code*, or ``None`` when the code is unknown."""
+    if not isinstance(code, str):
+        return None
+    with _lock:
+        return STORE.get(code)