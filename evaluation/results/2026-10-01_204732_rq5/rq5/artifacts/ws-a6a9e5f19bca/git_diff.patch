+
+# Kept at module scope so notes remain available for the lifetime of the process.
+NOTES: dict[str, dict[str, str]] = {}
+
+
+def create_note(text: str) -> str:
+    """Create a note and return its generated identifier."""
+    note_id = str(uuid4())
+    NOTES[note_id] = {"id": note_id, "text": text}
+    return note_id
+
+
+def list_notes() -> list[dict[str, str]]:
+    """Return all notes currently held in memory."""
+    return list(NOTES.values())
