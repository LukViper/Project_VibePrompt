+"""A small, dependency-free in-memory todo service.
+
+The module intentionally has no authentication layer.  The supplied project
+specification explicitly prohibits adding multi-user authentication.
+"""
+
+from __future__ import annotations
+
+from typing import TypedDict
+
+
+class Todo(TypedDict):
+    id: int
+    title: str
+    done: bool
+
+
+TODOS: dict[int, Todo] = {}
+_next_id = 1
+
+
+def _new_id() -> int:
+    """Return an id that remains unique even when callers clear ``TODOS``."""
+    global _next_id
+    todo_id = _next_id
+    _next_id += 1
+    return todo_id
 
 def add_todo(title):
-    raise NotImplementedError
+    """Create a todo and return its identifier.
+
+    Titles must be non-empty strings after trimming surrounding whitespace.
+    """
+    if not isinstance(title, str):
+        raise TypeError("title must be a string")
+    cleaned_title = title.strip()
+    if not cleaned_title:
+        raise ValueError("title must not be blank")
+
+    todo_id = _new_id()
+    TODOS[todo_id] = {"id": todo_id, "title": cleaned_title, "done": False}
+    return todo_id
 
 def complete_todo(todo_id):
-    raise NotImplementedError
+    """Mark an existing todo complete and return the updated todo."""
+    if not isinstance(todo_id, int) or isinstance(todo_id, bool):
+        raise TypeError("todo_id must be an integer")
+    try:
+        todo = TODOS[todo_id]
+    except KeyError as error:
+        raise KeyError(f"todo {todo_id} does not exist") from error
+    todo["done"] = True
+    return todo
