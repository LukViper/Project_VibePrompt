+from __future__ import annotations
+
+from typing import Any, Mapping
+
+from app.redis_cache import Cache, get_default_cache
+
+
+def health() -> dict[str, str]:
+    """Return a lightweight liveness response (REQ-001)."""
+    return {"status": "ok"}
+
+
+def echo(payload: Mapping[str, Any], *, cache: Cache | None = None) -> dict[str, Any]:
+    """Return *payload*, storing and retrieving it through Redis (REQ-002)."""
+    if not isinstance(payload, Mapping):
+        raise ValueError("payload must be a mapping")
+    value = dict(payload)
+    active_cache = cache or get_default_cache()
+    cached = active_cache.get(value)
+    if cached is not None:
+        return cached
+    active_cache.set(value)
+    return value
