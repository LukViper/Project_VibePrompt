+"""A deliberately small, in-memory authentication helper.
+
+The store lives only for the lifetime of the process; callers that need
+durability should replace it with a proper persistence layer.
+"""
+
+import hashlib
+import hmac
+import secrets
+
+
+# Kept public so a host application (and tests) can reset the in-memory store.
+# Passwords are never stored in this mapping in plaintext.
 USERS = {}
 
+_SALT_BYTES = 16
+_PBKDF2_ITERATIONS = 600_000
+
+
+class AuthenticationError(ValueError):
+    """Raised when supplied credentials cannot authenticate a user."""
+
+
+def _validate_credentials(username, password):
+    if not isinstance(username, str) or not username:
+        raise ValueError("username must be a non-empty string")
+    if not isinstance(password, str) or not password:
+        raise ValueError("password must be a non-empty string")
+
+
+def _password_hash(password, salt):
+    return hashlib.pbkdf2_hmac(
+        "sha256", password.encode("utf-8"), salt, _PBKDF2_ITERATIONS
+    )
+
+
 def register(username, password):
-    raise NotImplementedError
+    """Store a new user and return ``None``.
+
+    Duplicate usernames are rejected so registration cannot silently replace an
+    existing account.
+    """
+    _validate_credentials(username, password)
+    if username in USERS:
+        raise ValueError("username is already registered")
+
+    salt = secrets.token_bytes(_SALT_BYTES)
+    USERS[username] = {"salt": salt, "password_hash": _password_hash(password, salt)}
+
 
 def login(username, password):
-    raise NotImplementedError
+    """Authenticate a user and return a fresh opaque token string."""
+    _validate_credentials(username, password)
+    user = USERS.get(username)
+    if user is None:
+        raise AuthenticationError("invalid username or password")
+
+    supplied_hash = _password_hash(password, user["salt"])
+    if not hmac.compare_digest(supplied_hash, user["password_hash"]):
+        raise AuthenticationError("invalid username or password")
+
+    return secrets.token_urlsafe(32)