+"""Application operations.
 
-def health():
-    raise NotImplementedError('implement health')
+The public functions are deliberately framework-agnostic so they can be used
+from a web route, a CLI, or directly by another Python application.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import json
+from typing import Any, Mapping
+
+from .redis_store import Cache, RedisCache
+
+
+def _cache_key(payload: Mapping[str, Any]) -> str:
+    """Return a stable key without putting user data in a Redis key."""
+    encoded = json.dumps(payload, sort_keys=True, separators=(",", ":"), ensure_ascii=False)
+    return "echo:" + hashlib.sha256(encoded.encode("utf-8")).hexdigest()
+
+
+def echo(payload: Mapping[str, Any], cache: Cache | None = None) -> dict[str, Any]:
+    """Return a JSON-object payload, caching the response in Redis.
+
+    ``cache`` is injectable for tests.  When omitted, configuration is read
+    from environment variables by :class:`RedisCache`.
+    """
+    if not isinstance(payload, Mapping):
+        raise ValueError("payload must be a JSON object")
+
+    # Confirm it is safe to serialise before interacting with the database.
+    try:
+        normalized = json.loads(json.dumps(dict(payload), ensure_ascii=False))
+    except (TypeError, ValueError) as exc:
+        raise ValueError("payload must contain JSON-compatible values") from exc
+
+    active_cache = cache or RedisCache.from_environment()
+    key = _cache_key(normalized)
+    cached = active_cache.get(key)
+    if cached is not None:
+        return json.loads(cached)
+
+    result = normalized
+    active_cache.set(key, json.dumps(result, separators=(",", ":")))
+    return result
+
+
+def health() -> dict[str, str]:
+    """Return the liveness response required by REQ-001."""
+    return {"status": "ok"}
