+"""Small, dependency-free application operations.
 
-def health():
-    raise NotImplementedError('implement health')
+The module intentionally exposes plain Python functions so it can be used by a
+web adapter later without coupling the core health check to a framework.
+"""
+
+from typing import Any
+
+
+def echo(payload: Any) -> Any:
+    """Return the supplied payload unchanged.
+
+    This preserves the starter project's existing public operation.
+    """
+    return payload
+
+
+def health() -> dict[str, str]:
+    """Return the application's health status (REQ-001)."""
+    return {"status": "ok"}
