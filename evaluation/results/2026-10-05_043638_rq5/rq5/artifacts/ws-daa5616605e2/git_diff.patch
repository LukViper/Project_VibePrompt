+"""Small, dependency-free API operations for the application.
 
-def health():
-    raise NotImplementedError('implement health')
+The module is deliberately framework-neutral so it can be imported by a web
+adapter later without making the confirmed health-check requirement dependent
+on a particular framework.
+"""
+
+from typing import Any
+
+
+def echo(payload: Any) -> Any:
+    """Return *payload* unchanged.
+
+    This retained starter operation is intentionally side-effect free and does
+    not serialize or log caller-provided data.
+    """
+
+    return payload
+
+
+def health() -> dict[str, str]:
+    """Return the application's liveness status (REQ-001)."""
+
+    return {"status": "ok"}
